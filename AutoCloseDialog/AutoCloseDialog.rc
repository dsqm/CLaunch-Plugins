//------------------------------------------------------------------------------
// AutoCloseDialog.rc - version information only
//------------------------------------------------------------------------------
#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PLUGIN_VERSION_YEAR,PLUGIN_VERSION_MONTH,PLUGIN_VERSION_DAY,0
 PRODUCTVERSION PLUGIN_VERSION_YEAR,PLUGIN_VERSION_MONTH,PLUGIN_VERSION_DAY,0
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "CLaunch Auto-close Unfocused Dialogs"
            VALUE "FileVersion", PLUGIN_VERSION_A
            VALUE "InternalName", "AutoCloseDialog"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "AutoCloseDialog.dll"
            VALUE "ProductName", "CLaunch Auto-close Unfocused Dialogs"
            VALUE "ProductVersion", PLUGIN_VERSION_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
