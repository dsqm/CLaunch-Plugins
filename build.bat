@echo off
rem ===== CLaunch-Plugins portable build script (MSVC, Win32 + x64) =====
rem ASCII only (cmd.exe reads .bat as ANSI).
rem Builds every plugin's Release DLL for both architectures into bin\<arch>.
rem CLaunch.exe comes in 32-bit and 64-bit editions; a plugin DLL must match
rem the bitness of the host, so both flavors are produced unconditionally.
setlocal

set "PLUGINS=X1Toggle AutoCloseDialog AppHotkeys"

rem ===== Version = date of the plugin's last commit (auto-generated) =====
rem <plugin>\version.h feeds <plugin>.rc (VERSIONINFO, shown in the DLL file
rem properties) and <plugin>.cpp (about dialog). Same-date rebuilds keep the
rem file untouched so incremental compilation stays effective. Without git
rem info (e.g. building from a zip download) an existing version.h is kept.
for %%P in (%PLUGINS%) do call :gen_version %%P || exit /b 1

call :build_arch x86 Win32
if errorlevel 1 exit /b 1
call :build_arch x64 x64
if errorlevel 1 exit /b 1

echo.
for %%A in (Win32 x64) do for %%P in (%PLUGINS%) do (
    for %%F in ("bin\%%A\%%P.dll") do echo [OK] bin/%%A/%%P.dll built. size=%%~zF bytes
)
exit /b 0

:gen_version
set "P=%~1"
set "VERSTR="
for /f "usebackq delims=" %%d in (`git log -1 --format^=%%cs -- "%P%" 2^>nul`) do if not defined VERSTR set "VERSTR=%%d"
if not defined VERSTR if exist "%P%\version.h" exit /b 0
if not defined VERSTR for /f "usebackq delims=" %%t in (`powershell -NoProfile -Command "Get-Date -Format yyyy.MM.dd" 2^>nul`) do if not defined VERSTR set "VERSTR=%%t"
if not defined VERSTR (
    echo [ERROR] cannot determine version date for %P%
    exit /b 1
)
set "VERSTR=%VERSTR:-=.%"
for /f "tokens=1-3 delims=." %%a in ("%VERSTR%") do (
    set "VY=%%a"
    set "VM=%%b"
    set "VD=%%c"
)
rem Leading-zero month/day would parse as octal in set /a; 1VM %% 100 strips it.
set /a VMN=1%VM% %% 100
set /a VDN=1%VD% %% 100
> "%P%\version.h.new" echo /* Auto-generated by build.bat - do not edit. */
>> "%P%\version.h.new" echo /* Version = date of the last commit touching this plugin. */
>> "%P%\version.h.new" echo /* Regenerated only when that date changes. */
>> "%P%\version.h.new" echo #ifndef %P%_VERSION_INCLUDED
>> "%P%\version.h.new" echo #define %P%_VERSION_INCLUDED
>> "%P%\version.h.new" echo #define PLUGIN_VERSION_YEAR %VY%
>> "%P%\version.h.new" echo #define PLUGIN_VERSION_MONTH %VMN%
>> "%P%\version.h.new" echo #define PLUGIN_VERSION_DAY %VDN%
>> "%P%\version.h.new" echo #define PLUGIN_VERSION_A "%VERSTR%"
>> "%P%\version.h.new" echo #define PLUGIN_VERSION_W L"%VERSTR%"
>> "%P%\version.h.new" echo #ifdef UNICODE
>> "%P%\version.h.new" echo #define PLUGIN_VERSION_T PLUGIN_VERSION_W
>> "%P%\version.h.new" echo #else
>> "%P%\version.h.new" echo #define PLUGIN_VERSION_T PLUGIN_VERSION_A
>> "%P%\version.h.new" echo #endif
>> "%P%\version.h.new" echo #endif /* %P%_VERSION_INCLUDED */
fc /b "%P%\version.h.new" "%P%\version.h" >nul 2>&1
if errorlevel 1 (
    move /y "%P%\version.h.new" "%P%\version.h" >nul
) else (
    del "%P%\version.h.new"
)
exit /b 0

:build_arch
set "OUTARCH=%~2"
call "%~dp0build_env.bat" %~1
if errorlevel 1 exit /b 1
if not exist "bin\%OUTARCH%" mkdir "bin\%OUTARCH%"
if not exist "bin\obj\%OUTARCH%" mkdir "bin\obj\%OUTARCH%"
for %%P in (%PLUGINS%) do call :build_one %%P || exit /b 1
exit /b 0

:build_one
set "P=%~1"
pushd "%P%"
rc /nologo /fo "..\bin\obj\%OUTARCH%\%P%.res" "%P%.rc"
if errorlevel 1 (
    echo [ERROR] rc failed for %P%
    popd
    exit /b 1
)
rem Release flags mirror the .vcxproj: /O2 /W3 /MT, Unicode, NDEBUG,
rem dead-code + COMDAT folding on link. /GL+LTCG skipped on purpose.
if "%OUTARCH%"=="x64" (set "MACHINE=X64") else set "MACHINE=X86"
cl /nologo /O2 /W3 /MT /utf-8 /DUNICODE /D_UNICODE /DNDEBUG /D_WINDOWS /D_USRDLL /DWIN32 ^
   /Fo"..\bin\obj\%OUTARCH%\%P%.obj" ^
   "%P%.cpp" "..\bin\obj\%OUTARCH%\%P%.res" ^
   /link /DLL /OUT:"..\bin\%OUTARCH%\%P%.dll" /DEF:"%P%.def" ^
   /IMPLIB:"..\bin\obj\%OUTARCH%\%P%.lib" ^
   /SUBSYSTEM:WINDOWS /MACHINE:%MACHINE% /OPT:REF /OPT:ICF ^
   kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib ^
   advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib ^
   odbc32.lib odbccp32.lib
if errorlevel 1 (
    echo [ERROR] cl failed for %P%
    popd
    exit /b 1
)
popd
exit /b 0
